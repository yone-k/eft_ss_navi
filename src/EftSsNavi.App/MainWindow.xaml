<Window
    x:Class="EftSsNavi.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EFT Screenshot Navi">
    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="監視先" />
                <TextBox x:Name="WatchDirectoryText" Grid.Column="1" IsReadOnly="True" PlaceholderText="スクリーンショット監視先を選択してください" />
                <Button Grid.Column="2" Click="OnChooseWatchDirectoryClick" Content="変更" />
                <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Text="現在のマップ" />
                <DropDownButton x:Name="ProfileMenuButton" Grid.Column="4" Click="OnProfileMenuClick" Content="マップを選択" HorizontalContentAlignment="Left" />
                <Button x:Name="NewProfileButton" Grid.Column="5" Click="OnNewProfileClick" Content="マップを追加" />
                <Button x:Name="DeleteProfileButton" Grid.Column="6" Click="OnDeleteProfileClick" Content="マップを削除" />
                <Button x:Name="CorrectionModeButton" Grid.Column="7" Click="OnCorrectionModeClick" Content="位置を補正" IsEnabled="False" Visibility="Collapsed" />
                <Button x:Name="ConfirmCorrectionButton" Grid.Column="8" Click="OnConfirmCorrectionClick" Content="補正を確定" Visibility="Collapsed" />
                <Button x:Name="RotateMapLeftButton" Grid.Column="9" Click="OnRotateMapLeftClick" ToolTipService.ToolTip="マップを左へ90度回転" AutomationProperties.Name="マップを左へ90度回転" IsEnabled="False" Padding="8">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="20" Height="20">
                            <Path Data="M 7,8 L 3,4 L 7,0 M 3,4 A 8,8 0 1 1 3,16" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="RotateMapRightButton" Grid.Column="10" Click="OnRotateMapRightClick" ToolTipService.ToolTip="マップを右へ90度回転" AutomationProperties.Name="マップを右へ90度回転" IsEnabled="False" Padding="8">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="20" Height="20">
                            <Path Data="M 13,0 L 17,4 L 13,8 M 17,4 A 8,8 0 1 0 17,16" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Grid.Column="11" Click="OnFitMapClick" Content="マップ全体を表示" />
                <Button x:Name="PartyButton" Grid.Column="12" Click="OnPartyClick" Content="パーティ">
                    <Button.Flyout>
                        <Flyout x:Name="PartyFlyout" Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="300" Spacing="12">
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="パーティ" />
                                <StackPanel x:Name="PartyNotJoinedPanel" Spacing="8">
                                    <TextBlock Text="表示名" />
                                    <TextBox x:Name="PartyDisplayNameTextBox" MaxLength="16" PlaceholderText="1〜16文字" />
                                    <Button x:Name="HostPartyButton" Click="OnHostPartyClick" Content="ホストとして開始" HorizontalAlignment="Stretch" />
                                    <TextBlock Margin="0,4,0,0" Text="ルームコード" />
                                    <TextBox x:Name="PartyRoomCodeTextBox" MaxLength="19" PlaceholderText="XXXX-XXXX-XXXX-XXXX" CharacterCasing="Upper" />
                                    <Button x:Name="JoinPartyButton" Click="OnJoinPartyClick" Content="参加" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel x:Name="PartyHostPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="ホスト中" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PartyFlyoutRoomCodeText" FontFamily="Consolas" FontSize="22" Text="-------------------" />
                                    <Button x:Name="CopyPartyCodeButton" Click="OnCopyPartyCodeClick" Content="コードをコピー" HorizontalAlignment="Stretch" />
                                    <Button x:Name="ReissuePartyCodeButton" Click="OnReissuePartyCodeClick" Content="コードを再発行" HorizontalAlignment="Stretch" />
                                    <Button x:Name="EndPartyButton" Click="OnEndPartyClick" Content="セッションを終了" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel x:Name="PartyParticipantPanel" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="パーティに参加中" FontWeight="SemiBold" />
                                    <Button x:Name="LeavePartyButton" Click="OnLeavePartyClick" Content="退出" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MapHost" Grid.Column="0" />
            <Border Grid.Column="1" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="現在位置" />
                        <TextBlock x:Name="CoordinatesText" Text="X, Y, Z: —" TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="処理ファイル" />
                        <TextBlock x:Name="FileNameText" Text="—" TextWrapping="Wrap" />
                        <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                            <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="初期化中です。" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="マップ情報" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Canvas Width="24" Height="16">
                                    <Ellipse Canvas.Left="6" Canvas.Top="2" Width="12" Height="12" Fill="#3DC26A" Stroke="#141414" StrokeThickness="1" />
                                </Canvas>
                                <TextBlock VerticalAlignment="Center" Text="PMC脱出" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Canvas Width="24" Height="16">
                                    <Ellipse Canvas.Left="6" Canvas.Top="2" Width="12" Height="12" Fill="#28BEDC" Stroke="#141414" StrokeThickness="1" />
                                </Canvas>
                                <TextBlock VerticalAlignment="Center" Text="共同脱出" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Canvas Width="24" Height="16">
                                    <Ellipse Canvas.Left="6" Canvas.Top="2" Width="12" Height="12" Fill="#EE3242" Stroke="#141414" StrokeThickness="1" />
                                </Canvas>
                                <TextBlock VerticalAlignment="Center" Text="SCAV脱出" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Canvas Width="24" Height="16">
                                    <Ellipse Canvas.Left="6" Canvas.Top="2" Width="12" Height="12" Fill="#FF9123" Stroke="#141414" StrokeThickness="1" />
                                </Canvas>
                                <TextBlock VerticalAlignment="Center" Text="TRANSIT" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Canvas Width="24" Height="16">
                                    <Polygon Points="12,2 18,8 12,14 6,8" Fill="#FFAE30" Stroke="#141414" StrokeThickness="1" />
                                </Canvas>
                                <TextBlock VerticalAlignment="Center" Text="PMCスポーン" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="PartySection" Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="パーティ" />
                            <TextBlock x:Name="PartyNotJoinedText" Text="未参加" />
                            <TextBlock x:Name="PartyRoomCodeText" FontFamily="Consolas" Text="ルームコード: —" Visibility="Collapsed" />
                            <StackPanel x:Name="PartySelfParticipantRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                <Canvas Width="24" Height="20">
                                    <Ellipse Canvas.Left="6" Canvas.Top="4" Width="12" Height="12" Fill="#EE3242" Stroke="White" StrokeThickness="1" />
                                </Canvas>
                                <TextBlock x:Name="PartySelfDisplayNameText" VerticalAlignment="Center" FontWeight="SemiBold" Text="自分" />
                                <TextBlock x:Name="PartySelfStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="位置未受信" />
                            </StackPanel>
                            <ItemsControl x:Name="PartyParticipantList" />
                        </StackPanel>
                        <Border x:Name="ProgressiveCalibrationPanel" Padding="12" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="6" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="ProgressiveCalibrationProgressText" FontSize="18" FontWeight="SemiBold" Text="マップ校正 0/3" />
                                <TextBlock Text="スクリーンショットを検知したら、その位置をマップ上でクリックしてください。" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProgressiveCalibrationInstructionText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Padding="12,6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ホイール: 拡大・縮小 / ドラッグ: マップを移動" />
    </Grid>
</Window>
