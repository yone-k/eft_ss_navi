<Window
    x:Class="EftSsMap.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="EFT Screenshot Map">
    <Grid x:Name="RootGrid" Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="監視先" />
                <TextBox x:Name="WatchDirectoryText" Grid.Column="1" IsReadOnly="True" PlaceholderText="スクリーンショット監視先を選択してください" />
                <Button Grid.Column="2" Click="OnChooseWatchDirectoryClick" Content="変更" />
                <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Text="現在のマップ" />
                <DropDownButton x:Name="ProfileMenuButton" Grid.Column="4" Click="OnProfileMenuClick" Content="マップを選択" HorizontalContentAlignment="Left" />
                <Button Grid.Column="5" Click="OnNewProfileClick" Content="マップを追加" />
                <Button Grid.Column="6" Click="OnDeleteProfileClick" Content="マップを削除" />
                <Button x:Name="CorrectionModeButton" Grid.Column="7" Click="OnCorrectionModeClick" Content="位置を補正" IsEnabled="False" />
                <Button x:Name="ConfirmCorrectionButton" Grid.Column="8" Click="OnConfirmCorrectionClick" Content="補正を確定" Visibility="Collapsed" />
                <Button Grid.Column="9" Click="OnFitMapClick" Content="マップ全体を表示" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="MapHost" Grid.Column="0" />
            <Border Grid.Column="1" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="現在位置" />
                        <TextBlock x:Name="CoordinatesText" Text="X, Y, Z: —" TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="処理ファイル" />
                        <TextBlock x:Name="FileNameText" Text="—" TextWrapping="Wrap" />
                        <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                            <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="初期化中です。" TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="ProgressiveCalibrationPanel" Padding="12" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="6" Visibility="Collapsed">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="ProgressiveCalibrationProgressText" FontSize="18" FontWeight="SemiBold" Text="マップ校正 0/3" />
                                <TextBlock Text="スクリーンショットを検知したら、その位置をマップ上でクリックしてください。" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProgressiveCalibrationInstructionText" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Padding="12,6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ホイール: 拡大・縮小 / ドラッグ: マップを移動" />
    </Grid>
</Window>
